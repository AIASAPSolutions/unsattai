# UrJersey API settings. Copy to server/.env for local runs; the API reads it on start.
# Real environment variables (Docker, a hosting dashboard) always win over this file.
# Never commit server/.env. Business settings (prices, delivery zones, production stages,
# company details, coupons, sellers) are not here: change them in the operations app.

# ---- Basics ----
# production turns off every development shortcut
APP_ENV=development
# empty = server/data/designs.db
DB_PATH=
# production: https://ops.example.com,https://shop.example.com
CORS_ORIGINS=*
LOG_LEVEL=INFO
# used in SMS, emails and codes
BRAND_NAME=UrJersey
# e.g. https://shop.example.com, adds "View your order" links to emails
PUBLIC_SHOP_URL=

# ---- First operations admin (created on the first start only, when there are no staff yet) ----
ADMIN_EMAIL=owner@example.com
# 10+ characters with upper and lower case letters and a digit
ADMIN_PASSWORD=

# ---- Sign-in codes and accounts ----
# 1 = the code is also returned by the API (local testing only; always off in production)
OTP_DEV_ECHO=1
# how long a code works
OTP_MINUTES=10
# wrong tries before a new code is needed
OTP_MAX_ATTEMPTS=5
# wait before another code can be sent
OTP_RESEND_SECONDS=30
# empty = "{code} is your {brand} code. It expires in {minutes} minutes. Don't share it."
OTP_SMS_TEXT=
# empty = "Your {brand} code: {code}"
OTP_EMAIL_SUBJECT=
# wrong passwords before the account is locked for a while
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# after signing in with a code, how long a new password can be set without the old one
PASSWORD_RESET_MINUTES=15
CUSTOMER_SESSION_DAYS=60
STAFF_SESSION_DAYS=1

# ---- SMS: log | msg91 | twilio | webhook ----
SMS_PROVIDER=log
# MSG91 (India, DLT). Create two Flow templates. The OTP template uses ##otp## (and may use
# ##minutes## and ##brand##); the order template uses ##message## (and may use ##number##).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# empty = order updates are not sent by SMS (email and in-app still are)
MSG91_ORDER_TEMPLATE_ID=
# your approved 6-letter sender id, if the template needs it
MSG91_SENDER_ID=
# empty = https://control.msg91.com/api/v5/flow
MSG91_FLOW_URL=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# a Twilio number, or use TWILIO_MESSAGING_SERVICE_SID instead
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Any other service: we POST {"to", "text", "otp"?, "number"?, "message"?} as JSON, with an optional bearer token.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- Email: log | smtp | resend | webhook ----
EMAIL_PROVIDER=log
# must be an address your provider lets you send from
EMAIL_FROM=UrJersey <no-reply@example.com>
EMAIL_REPLY_TO=
EMAIL_BRAND_COLOUR=#14225c
EMAIL_FOOTER=
# SMTP works with Gmail/Google Workspace, Zoho, Brevo, Amazon SES, Resend, Postmark, Mailgun and most others.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Resend's HTTP API (instead of SMTP)
RESEND_API_KEY=
# Any other service: we POST {"to", "subject", "text", "html"} as JSON.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ---- Design engine and AI help (optional; the built-in engine costs nothing) ----
# auto | rule | claude | slm
DESIGN_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
# auto | claude | slm | off
AI_EDITS=auto
AI_EDIT_MODEL=claude-haiku-4-5
AI_FREE_EDITS_PER_DAY=10
AI_BONUS_EDITS_PER_ORDER=20
AI_EDITS_PER_MINUTE=4
# AI calls per day for everyone together; 0 = no cap
AI_DAILY_BUDGET=2000
# your own small model (OpenAI-compatible server), if any
SLM_BASE_URL=http://localhost:11434/v1
SLM_MODEL=sportswear-spec
SLM_TIMEOUT=60

# ---- Payments ----
# "Pay (demo)" marks orders paid without taking money. Empty = on locally, off when APP_ENV=production.
# Set 1 only for a closed pilot where you check every payment yourself.
DEMO_PAYMENTS=

# ---- Factory hand-off (empty = paid orders go to the TEST queue) ----
FACTORY_URL=
FACTORY_TOKEN=

# ---- Limits and keys ----
MAX_UPLOAD_MB=12
MAX_CART_ITEMS=20
# comma-separated; empty = open API (customers and staff still sign in)
API_KEYS=
