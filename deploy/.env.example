# ---- Domains (create DNS "A" records for all three pointing at this server) ----
SHOP_DOMAIN=shop.example.com
API_DOMAIN=api.example.com
OPS_DOMAIN=ops.example.com
ACME_EMAIL=you@example.com          # for Let's Encrypt certificate notices

# ---- First operations admin (created on first start; change the password after signing in) ----
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-Passw0rd

# ---- Sign-in codes ----
# 0 in production: codes are never shown in API responses. Connect SMS/email below.
OTP_DEV_ECHO=0
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ---- Design engine and AI help (optional) ----
DESIGN_PROVIDER=rule                # rule = built-in engine, no cost. Set claude + ANTHROPIC_API_KEY for AI designs.
AI_EDITS=off                        # auto / claude / off
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET=2000

# ---- Factory hand-off (empty = paid orders go to the TEST queue) ----
FACTORY_URL=
FACTORY_TOKEN=

# ---- Optional channel key ----
# Leave API_KEYS empty for a public store: customers are protected by sign-in, staff by staff login.
# If you set it, also set API_KEY_WEB to one of the keys, and type a key into the mobile app's Settings.
API_KEYS=
API_KEY_WEB=
