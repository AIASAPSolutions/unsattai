# Where the UrJersey API (FastAPI, server/) listens. Only the web server talks to it.
UJ_API_URL=http://127.0.0.1:8000
# Channel key for the API when the server sets API_KEYS. Never exposed to the browser.
UJ_API_KEY=
# Public address of this store, used for absolute share links and SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Session cookies need HTTPS in production builds. Set 0 only to try a production build over plain http.
UJ_COOKIE_SECURE=
