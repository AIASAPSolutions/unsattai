{
  "expo": {
    "name": "Unsattai",
    "slug": "unsattai",
    "scheme": "unsattai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b1124",
    "ios": {
      "bundleIdentifier": "com.unsattai.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.unsattai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b1124",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "unsattai" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b1124"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Unsattai needs your photos to add your team logo or a design picture.",
          "cameraPermission": false,
          "microphonePermission": "Unsattai uses the microphone so you can describe designs by voice."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Unsattai uses the microphone so you can describe designs by voice.",
          "speechRecognitionPermission": "Unsattai turns your speech into text for design briefs and edits.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": null
    }
  }
}
