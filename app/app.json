{
  "expo": {
    "name": "UrJersey",
    "slug": "urjersey",
    "scheme": "urjersey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b1124",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1124"
    },
    "ios": {
      "bundleIdentifier": "com.urjersey.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.urjersey.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b1124",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "urjersey" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "UrJersey needs your photos to add your team logo to a design.",
          "cameraPermission": false,
          "microphonePermission": "UrJersey uses the microphone so you can describe designs by voice."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "UrJersey uses the microphone so you can describe designs by voice.",
          "speechRecognitionPermission": "UrJersey turns your speech into text for design briefs and edits.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": null
    }
  }
}
