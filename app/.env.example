# Copy to app/.env for local runs. For EAS builds set the same names with `eas env:create`
# (or in the EAS dashboard). Only EXPO_PUBLIC_* values reach the app's code, and they are
# visible inside the app, so never put secrets here. The API key, if you use one, is typed
# on the app's Settings screen and kept in the phone's secure storage.

# The UrJersey API. Leave empty locally to use the computer running `npx expo start`, port 8000.
EXPO_PUBLIC_API_URL=
# Optional: a web page that takes payment for an order (the order id is added to it).
EXPO_PUBLIC_CHECKOUT_URL=

# ---- Build identity (read by app.config.ts) ----
APP_NAME=UrJersey
APP_SLUG=urjersey
APP_SCHEME=urjersey
APP_VERSION=1.0.0
IOS_BUNDLE_ID=com.urjersey.app
ANDROID_PACKAGE=com.urjersey.app
# From `eas init` (links the project to your Expo account) and your Expo user or organisation.
EAS_PROJECT_ID=
EXPO_OWNER=
# 1 lets the app call http:// addresses on your network (local testing). Use 0 for store builds.
APP_ALLOW_HTTP=1
