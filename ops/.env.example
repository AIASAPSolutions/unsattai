# Where the Unsattai API runs (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000
# Only when the API sets API_KEYS: sent as X-API-Key on design, render, print-file and shop endpoints.
# It ends up in the browser bundle, so use a key issued for the ops app only.
VITE_API_KEY=
# The customer web store, used to build quote links (<store>/quote/<token>).
VITE_WEB_STORE_URL=http://127.0.0.1:3000
