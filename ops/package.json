{
  "name": "urjersey-ops",
  "private": true,
  "version": "1.0.0",
  "description": "UrJersey Ops: the staff back-office for pricing, production, delivery, orders and CRM.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "NODE_PATH=${NODE_PATH:-$(npm root -g)} node e2e/ops-flow.mjs",
    "e2e:full": "bash e2e/run.sh"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
