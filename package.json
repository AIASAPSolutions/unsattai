{
  "name": "clinivio-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:seed": "ts-node -r tsconfig-paths/register libs/database/src/seed.ts",
    "db:migrate": "typeorm-ts-node-commonjs -d apps/api/src/config/datasource.ts migration:run",
    "db:migration:show": "typeorm-ts-node-commonjs -d apps/api/src/config/datasource.ts migration:show",
    "db:migration:revert": "typeorm-ts-node-commonjs -d apps/api/src/config/datasource.ts migration:revert",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "typeorm": "typeorm-ts-node-commonjs -d apps/api/src/config/datasource.ts",
    "smoke": "ts-node --project scripts/tsconfig.json scripts/smoke-test.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.4",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "**/*.{ts,json}": [
      "pnpm exec prettier --write --ignore-unknown"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": ">=2.3.0",
      "js-yaml": ">=4.3.2",
      "lodash": ">=4.18.0",
      "glob": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "tmp": ">=0.2.6",
      "qs": ">=6.16.0",
      "body-parser": ">=1.20.6",
      "uuid": ">=11.1.1",
      "file-type": ">=21.3.2",
      "ajv": ">=8.18.0",
      "rimraf>glob": "^7.2.3",
      "test-exclude>glob": "^7.2.3",
      "@eslint/eslintrc>ajv": "^6.12.6",
      "eslint>ajv": "^6.12.6"
    }
  },
  "dependencies": {
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "socket.io": "^4.8.4"
  }
}
